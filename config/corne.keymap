#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";
        hj_asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <18 19>;
        };
        nm_plus {
            bindings = <&kp PLUS>;
            key-positions = <30 31>;
        };
    };

    behaviors {
        td_lshft_caps: td_lshft_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LSHFT_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I       &kp O    &kp P     &kp BSPC
&td_lshft_caps  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K       &kp L    &kp SEMI  &kp LBKT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA   &kp DOT  &kp FSLH  &kp ESC
                          &kp LALT  &mo 2  &kp SPACE        &kp RET  &mo 1  &kp INSERT
            >;
        };
        lower_layer {
            bindings = <
&kp TAB         &kp RA(Q)           &kp UP_ARROW          &none              &none           &none                       &kp AMPERSAND        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9      &kp EQUAL       &kp DELETE
&td_lshft_caps  &kp LEFT_ARROW      &kp DOWN_ARROW       &kp RIGHT_ARROW     &kp ASTERISK    &kp LEFT_PARENTHESIS        &kp DOT              &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6      &kp ASTERISK    &kp KP_DIVIDE
&kp LCTRL       &trans             &trans                &trans              &kp UNDERSCORE  &kp EXCL                    &kp NUMBER_0         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp PLUS  &kp MINUS
                                &kp LGUI  &trans          &kp SPACE                                                        &kp RET       &trans        &kp RALT
            >;
        };
        raise_layer {
            bindings = <
&kp TAB          &kp EXCLAMATION  &kp AT_SIGN  &kp HASH    &kp DOLLAR          &kp PERCENT                       &kp AMPERSAND        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9      &kp EQUAL       &kp DELETE
&kp LSHFT         &kp EXCL      &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS    &kp DOT              &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6      &kp ASTERISK    &kp KP_DIVIDE
&kp LCTRL         &trans          &trans      &trans      &kp LEFT_BRACKET   &kp RIGHT_BRACKET                   &kp NUMBER_0         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp PLUS        &kp MINUS
                                              &kp LGUI    &trans             &kp SPACE                           &kp RET          &trans           &kp RALT
            >;
        };
        layer_3 {
            bindings = <
&kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT      &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP           &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp PIPE       &kp GRAVE       &kp QUESTION      &trans
&studio_unlock    &bt BT_PRV      &bt BT_NXT     &bt BT_CLR  &trans              &trans                   &kp AT                 &kp SINGLE_QUOTE   &kp BSLH       &kp PIPE2       &kp CARET      &trans
&trans          &trans          &trans           &trans      &trans              &trans                   &ext_power EP_ON       &ext_power EP_OFF  &kp TILDE2         &trans          &trans      &trans
                                &trans      &trans      &kp SPACE                                        &kp ENTER              &trans             &kp RIGHT_ALT
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        extra_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
